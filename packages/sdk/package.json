{
  "name": "ai-eval-kit",
  "version": "1.0.0",
  "description": "Developer-first framework for evaluating LLM applications, agents, prompts, RAG pipelines, and AI workflows",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch"
  },
  "dependencies": {
    "@ai-eval/core": "workspace:*",
    "@ai-eval/datasets": "workspace:*",
    "@ai-eval/evaluators": "workspace:*",
    "@ai-eval/providers": "workspace:*",
    "@ai-eval/reporters": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.4.0",
    "typescript": "^5.8.2"
  }
}
