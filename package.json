{
  "name": "ai-eval-kit-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Open-source evaluations, regression testing, and benchmarking for AI applications",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "lint": "pnpm typecheck && pnpm format:check",
    "format": "prettier --write \"**/*.{ts,tsx,json,yaml,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,yaml,md}\""
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "prettier": "^3.5.3",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  },
  "bin": {
    "ai-eval": "./apps/cli/dist/bin.js"
  },
  "type": "module"
}
